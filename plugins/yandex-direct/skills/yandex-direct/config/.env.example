# yandex-direct — настройки скилла. Ничего обязательного здесь нет:
# токен ищется сначала в переменных окружения, затем в этом файле, затем в
# ~/.claude/secrets/yandex-direct-app.json (поле access_token), куда его кладёт
# мастер scripts/direct-oauth-flow.sh.

# OAuth-токен пользователя с доступом к API Директа. Как получить — config/API_ACCESS.md.
# YANDEX_DIRECT_TOKEN=

# Путь к JSON-файлу с токеном, если он лежит не по умолчанию.
# YANDEX_DIRECT_TOKEN_FILE=~/.claude/secrets/yandex-direct-app.json

# Логин рекламного кабинета — значение ulogin в его адресе в Директе.
# Для агентства это логин клиента, которому принадлежит реклама.
# Флаг --account и сохранённый выбор accounts.py --use имеют приоритет.
# Если неархивный кабинет один, он выбирается сам.
# YANDEX_DIRECT_ACCOUNT=
# Прежнее имя той же настройки, поддерживается для совместимости:
# YANDEX_DIRECT_CLIENT_LOGIN=

# Язык ответов API: ru | en | tr
YANDEX_DIRECT_LOCALE=ru

# Чьими баллами платить под агентским токеном: auto | never | always
YANDEX_DIRECT_USE_OPERATOR_UNITS=auto

# Профиль контура: production | test_cabinet.
# Для test_cabinet токен и кабинет берутся из переменных с суффиксом _TEST_CABINET.
# YANDEX_DIRECT_ENV=production
# YANDEX_DIRECT_TOKEN_TEST_CABINET=
# YANDEX_DIRECT_ACCOUNT_TEST_CABINET=

# client_id приложения для мастера токена. По умолчанию «Claud direct».
# Задавать, когда у компании своё приложение с одобренной заявкой на API.
# YANDEX_DIRECT_CLIENT_ID=
# YANDEX_DIRECT_APP_NAME=
